# FutureWallet Python Paketleri

# Uygulama bağımlılıkları için requirements.txt kullanın:
#   pip install -r requirements.txt
#
# Geliştirme ortamı için (opsiyonel):
#   pip install -e ".[dev]"
#
# .env dosyası şu değişkenleri içermelidir:
#   GOOGLE_API_KEY=...
#   TCMB_API_KEY=...
#   FRED_API_KEY=...
#   DEBUG=true   # (opsiyonel)
