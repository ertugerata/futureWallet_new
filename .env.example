# .env.example (development defaults – replace with real secrets in production)
# ------------------------------------------------------------
# REQUIRED PocketBase admin credentials (must be set via .env)
POCKETBASE_EMAIL=
POCKETBASE_PASSWORD=

# Optional: API token for FastAPI auth (leave empty for dev)
API_TOKEN=

# CORS allowed origins (comma‑separated)
ALLOWED_ORIGINS=

# Trusted host headers (comma‑separated)
ALLOWED_HOSTS=localhost,127.0.0.1

# Database URL (SQLite default for local dev)
DATABASE_URL=sqlite:///./data/futurewallet.db

# Google Gemini / OpenRouter API key
GOOGLE_API_KEY=
GEMINI_MODEL=

# Market data API keys
TCMB_API_KEY=
FRED_API_KEY=

# Debug mode (true|false)
DEBUG=false

# FastAPI bind address and port
APP_HOST=127.0.0.1
APP_PORT=8000
