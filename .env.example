# FutureWallet .env örneği
# ============================================
# Bu dosyayı kopyala:  cp .env.example .env
# Ardından kendi değerlerinizi girin.
#
# GÜVENLİK NOTU: .env içinde API key'leriniz vardır.
#   - Bu dosya asla repository'a eklenmemelidir (.gitignore'da zaten var).
#   - Production'da secrets manager / environment injection ile geçin.
#   - .env dosyasını her zaman .gitignore ile koruyun.

# ---------------------------------------------------------------------------
# Kimlik Doğrulama
# ---------------------------------------------------------------------------
# API_TOKEN: FutureWallet API'sine erişim token'ı.
#   - http:// (...) origin'lerden gelen isteklerde Authorization: Bearer <token>
#     başlığı ile gönderilir.
#   - Boş bırakılırsa ve DEBUG=false ise uygulama başlamaz (fail-closed).
#   - Güçlü bir token üretin: python -c "import secrets; print(secrets.token_hex(32))"
API_TOKEN=

# hangi Origin'lerin API'ye erişebileceği (virgülle ayrılmış).
# Boş bırakılırsa CORS middleware hiç eklenmez — yalnızca same-origin.
# Örnek: http://localhost:8000,https://app.futurewallet.local
ALLOWED_ORIGINS=

# Hangi Host header değerlerinin kabul edileceği (virgülle ayrılmış).
# Boş bırakılırsa TrustedHostMiddleware hiç eklenmez.
ALLOWED_HOSTS=localhost,127.0.0.1

# ---------------------------------------------------------------------------
# Veritabanı
# ---------------------------------------------------------------------------
# DATABASE_URL: SQLAlchemy/DB URL'si.
#   - Varsayılan: ./data/futurewallet.db (SQLite; Docker compose kalıcılıkla)
#   - Alternatif: postgresql://user:pass@host:5432/futurewallet
DATABASE_URL=sqlite:///./data/futurewallet.db

# ---------------------------------------------------------------------------
# Google Gemini / OpenRouter AI
# ---------------------------------------------------------------------------
# GOOGLE_API_KEY: Gemini API anahtarı.
#   - Boşsa AI servisler 503 döner (api/app.py'deki pattern).
#   - Prompt 7GPT: google-genai SDK'sı kullanılır (google-generativeai DEPRECATED).
GOOGLE_API_KEY=

# Kullanılacak model adı (config'ten okunur, kodda sabit DEĞİL).
# Örnek: google/gemini-2.0-flash, anthropic/claude-3.5-sonnet
# (OpenRouter model naming conventionına uygun)
GEMINI_MODEL=

# ---------------------------------------------------------------------------
# Piyasa Veri API'leri (benchmark_service için)
# ---------------------------------------------------------------------------
# TCMB_API_KEY: TCMB EVDS API anahtarı (TÜFE verisi için).
#   - Yoksa TÜFE için "veri yok" döner; uydurma veri üretilmez.
TCMB_API_KEY=

# FRED_API_KEY: US CPI verisi için FRED API anahtarı.
#   - Yoksa US CPI için fallback yok (Prompt 11: fallback kaldırıldı).
FRED_API_KEY=

# ---------------------------------------------------------------------------
# Uygulama (opsiyonel — varsayılanlar yeterli)
# ---------------------------------------------------------------------------
# DEBUG: true|false. Production'da false olmalı.
DEBUG=false

# APP_HOST: FastAPI bind adresi. Varsayılan 127.0.0.1 (Prompt 1: 0.0.0.0 kaldırıldı).
#   - Docker'da reverse proxy ile exposure yapılmalı.
APP_HOST=127.0.0.1

# APP_PORT: FastAPI portu. Varsayılan 8000.
APP_PORT=8000
