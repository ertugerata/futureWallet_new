# .env.example (development defaults – replace with real secrets in production)
# ------------------------------------------------------------
# REQUIRED PocketBase admin credentials (must be set via .env)
POCKETBASE_EMAIL=
POCKETBASE_PASSWORD=

# Optional: API token for FastAPI auth (leave empty for dev)
API_TOKEN=

# CORS allowed origins (comma‑separated)
ALLOWED_ORIGINS=

# Trusted host headers (comma‑separated)
ALLOWED_HOSTS=localhost,127.0.0.1

# OpenRouter AI API configuration
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODELS=anthropic/claude-3.5-sonnet,google/gemini-2.0-flash-001,deepseek/deepseek-r1

# Scheduler (true|false)
ENABLE_SCHEDULER=true

# Market data API keys
TCMB_API_KEY=
FRED_API_KEY=

# Debug mode (true|false)
DEBUG=false

# FastAPI bind address and port
APP_HOST=127.0.0.1
APP_PORT=8000
